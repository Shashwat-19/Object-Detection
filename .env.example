# Environment variables read by the application.
#
# The app reads these from the process environment. It does not load a .env
# file by itself, so export the values in your shell or let your host set them.
# Copy this file to .env only if you use a tool that loads .env files.

# Port the web server listens on. Used by the Procfile, render.yaml, and
# `python app.py`. Use 8000 locally (macOS uses port 5000 for AirPlay Receiver).
PORT=8000

# Set to 1 to serve /debug, which shows paths, memory, and library versions.
# Leave unset in production. The route returns 404 when this is not set.
ENABLE_DEBUG_ENDPOINT=0

# Set to 1 to run `python app.py` with the Werkzeug debugger. The debugger allows
# code execution from the browser, so use it only on your own machine.
# gunicorn ignores this setting.
FLASK_DEBUG=0
