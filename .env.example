# Environment variables read by the application.
#
# The app reads these from the process environment. It does not load a .env
# file by itself, so export the values in your shell or let your host set them.
#
# Copy this file to .env only if you use a tool that loads .env files.

# Port the web server listens on. Used by the Procfile, render.yaml, and `python app.py`.
# Local default in the quickstart: 8000.
PORT=8000
